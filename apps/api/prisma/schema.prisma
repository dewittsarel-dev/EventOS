  endTime         String?
  location        String?
  meetingType     MeetingType
  summary         String?
  discussionNotes String?
  decisions       String?
  nextMeetingDate DateTime?
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy       User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  attendees       MeetingAttendee[]
  actionItems     MeetingActionItem[]

  @@index([organizationId])
  @@index([eventId])
  @@index([meetingDate])
  @@index([meetingType])
  @@index([title])
}

model MeetingAttendee {
  id                 String                @id @default(uuid())
  meetingNoteId      String
  name               String
  email              String?
  roleOrOrganization String?
  attendanceStatus   MeetingAttendeeStatus
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  meetingNote        MeetingNote           @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)

  @@index([meetingNoteId])
  @@index([email])
  @@index([attendanceStatus])
}

model MeetingActionItem {
  id                  String                    @id @default(uuid())
  meetingNoteId       String
  description         String
  assignedUserId      String?
  assignedContactName String?
  dueDate             DateTime?
  priority            MeetingActionItemPriority
  status              MeetingActionItemStatus
  linkedTaskId        String?                   @unique
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  meetingNote         MeetingNote               @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  assignedUser        User?                     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  linkedTask          Task?                     @relation("MeetingActionItemLinkedTask", fields: [linkedTaskId], references: [id], onDelete: SetNull)

  @@index([meetingNoteId])
  @@index([assignedUserId])
  @@index([dueDate])
  @@index([priority])
  @@index([status])
}

model Supplier {
  id                      String              @id @default(uuid())
  organizationId          String
  companyName             String
  category                SupplierCategory
  primaryContactName      String?
  phone                   String?
  mobile                  String?
  email                   String?
  website                 String?
  physicalAddress         String?
  city                    String?
  province                String?
  postalCode              String?
  vatNumber               String?
  registrationNumber      String?
  preferredSupplier       Boolean             @default(false)
  active                  Boolean             @default(true)
  preferredPaymentTerms   String?
  internalRating          Int?
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferredInventoryItems InventoryItem[]
  purchaseOrders          PurchaseOrder[]
  eventLinks              SupplierEvent[]
  quotationLinks          SupplierQuotation[]
  taskLinks               SupplierTask[]
  products                SupplierProduct[]
  resources               Resource[]

  @@index([organizationId])
  @@index([companyName])
  @@index([category])
  @@index([preferredSupplier])
  @@index([active])
  @@index([internalRating])
}

model SupplierProduct {
  id                     String                  @id @default(uuid())
  organizationId         String
  supplierId             String
  productName            String
  sku                    String?
  category               SupplierProductCategory
  brand                  String?
  description            String?
  unit                   SupplierProductUnit
  costPrice              Float
  sellingPrice           Float?
  vatPercent             Float?
  leadTimeDays           Int?
  minimumOrderQuantity   Float?
  preferredProduct       Boolean                 @default(false)
  active                 Boolean                 @default(true)
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier               Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrderLineItems PurchaseOrderLineItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([supplierId])
  @@index([productName])
  @@index([category])
  @@index([active])
  @@index([preferredProduct])
}

model InventoryCategory {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          InventoryItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([active])
}

model StorageLocation {
  id              String          @id @default(uuid())
  organizationId  String
  name            String
  code            String
  physicalAddress String?
  city            String?
  province        String?
  notes           String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[] @relation("PurchaseOrderDeliveryLocation")
  goodsReceipts   GoodsReceipt[]
  resources       Resource[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([active])
}

model Resource {
  id                  String                     @id @default(uuid())
  organizationId      String
  supplierId          String?
  name                String
  description         String?
  category            String
  tags                String[]                   @default([])
  keywords            String[]                   @default([])
  aiSummary           String?
  searchPhrases       String[]                   @default([])
  imageUrls           String[]                   @default([])
  resourceType        ResourceType
  quantityMode        ResourceQuantityMode
  sku                 String?
  barcode             String?
  status              ResourceStatus             @default(AVAILABLE)
  visibility          ResourceVisibility         @default(PRIVATE)
  unit                String
  totalQuantity       Float?
  condition           ResourceCondition          @default(UNKNOWN)
  locationId          String?
  purchaseValue       Float?
  replacementValue    Float?
  rentalPrice         Float?
  damagedQuantity     Float                      @default(0)
  maintenanceQuantity Float                      @default(0)
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  archivedAt          DateTime?
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier            Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location            StorageLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reservations        ResourceReservation[]
  allocations         EventResourceAllocation[]
  outstandings        EventResourceOutstanding[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([resourceType])
  @@index([quantityMode])
  @@index([status])
  @@index([visibility])
  @@index([archivedAt])
  @@index([supplierId])
  @@index([locationId])
}

model ResourceReservation {
  id             String                        @id @default(uuid())
  organizationId String
  resourceId     String
  sourceType     ResourceReservationSourceType
  sourceId       String
  quantity       Float                         @default(1)
  startDateTime  DateTime
  endDateTime    DateTime
  status         ResourceReservationStatus     @default(DRAFT)
  notes          String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       Resource                      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  allocation     EventResourceAllocation?

  @@index([organizationId])
  @@index([resourceId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([startDateTime, endDateTime])
}

model EventResourceAllocation {
  id                    String                        @id @default(uuid())
  organizationId        String
  eventId               String
  resourceId            String
  resourceReservationId String?                       @unique
  quantityRequested     Float
  quantityReserved      Float
  quantityReturned      Float                         @default(0)
  quantityDamaged       Float                         @default(0)
  quantityLost          Float                         @default(0)
  reservedDate          DateTime
  expectedReturnDate    DateTime?
  actualReturnDate      DateTime?
  status                EventResourceAllocationStatus @default(Reserved)
  createdByUserId       String
  updatedByUserId       String
  notes                 String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                 Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource              Resource                      @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  reservation           ResourceReservation?          @relation(fields: [resourceReservationId], references: [id], onDelete: SetNull)
  createdBy             User                          @relation("EventResourceAllocationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy             User                          @relation("EventResourceAllocationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  outstandings          EventResourceOutstanding[]

  @@index([organizationId])
  @@index([eventId])
  @@index([resourceId])
  @@index([status])
  @@index([reservedDate])
}

model EventResourceOutstanding {
  id                  String                         @id @default(uuid())
  organizationId      String
  eventId             String
  resourceId          String
  allocationId        String?
  requestedQuantity   Float
  reservedQuantity    Float
  outstandingQuantity Float
  status              EventResourceOutstandingStatus @default(Open)
  createdByUserId     String
  notes               String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  organization        Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event               Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource            Resource                       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  allocation          EventResourceAllocation?       @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  createdBy           User                           @relation("EventResourceOutstandingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([eventId])
  @@index([resourceId])
  @@index([status])
}

model InventoryItem {
  id                     String                         @id @default(uuid())
  organizationId         String
  publicName             String?
  internalName           String?
  sku                    String
  barcode                String?
  qrCode                 String?
  name                   String
  description            String?
  shortDescription       String?
  longDescription        String?
  internalNotes          String?
  marketplaceTitle       String?
  marketplaceDescription String?
  aiSummary              String?
  aiKeywords             String[]                       @default([])
  aiTags                 String[]                       @default([])
  aiConfidence           Float?
  categoryId             String
  subCategory            String?
  brand                  String?
  preferredSupplierId    String?
  resourceStatus         InventoryResourceStatus        @default(Active)
  itemType               InventoryItemType
  unitOfMeasure          UnitOfMeasure
  style                  String?
  theme                  String?
  colour                 String?
  material               String?
  dimensions             String?
  weight                 String?
  capacity               String?
  indoorOutdoor          InventoryIndoorOutdoor         @default(Both)
  suitableEventTypes     String[]                       @default([])
  manualTags             String[]                       @default([])
  keywords               String[]                       @default([])
  aiGeneratedTags        String[]                       @default([])
  marketplaceVisibility  InventoryMarketplaceVisibility @default(Private)
  photoUrls              String[]                       @default([])
  primaryPhotoUrl        String?
  photoAssets            Json?
  costPrice              Float?
  replacementValue       Float?
  rentalPrice            Float?
  sellingPrice           Float?
  taxable                Boolean                        @default(false)
  active                 Boolean                        @default(true)
  trackQuantity          Boolean                        @default(true)
  trackSerialNumbers     Boolean                        @default(false)
  minimumStock           Float?
  reorderLevel           Float?
  notes                  String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  organization           Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category               InventoryCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preferredSupplier      Supplier?                      @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  goodsReceiptLines      GoodsReceiptLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([preferredSupplierId])
  @@index([itemType])
  @@index([resourceStatus])
  @@index([style])
  @@index([theme])
  @@index([material])
  @@index([colour])
  @@index([marketplaceVisibility])
  @@index([active])
  @@index([name])
}

model StockLevel {
  inventoryItemId   String
  storageLocationId String
  quantityOnHand    Float           @default(0)
  quantityReserved  Float           @default(0)
  updatedAt         DateTime        @updatedAt
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@id([inventoryItemId, storageLocationId])
  @@index([storageLocationId])
}

model StockMovement {
  id                String            @id @default(uuid())
  organizationId    String
  inventoryItemId   String
  storageLocationId String
  movementType      StockMovementType
  quantity          Float
  reference         String?
  reason            String?
  notes             String?
  createdByUserId   String
  createdAt         DateTime          @default(now())
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  storageLocation   StorageLocation   @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  createdBy         User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([storageLocationId])
  @@index([movementType])
  @@index([createdAt])
}

model PurchaseOrder {
  id                   String                  @id @default(uuid())
  organizationId       String
  purchaseOrderNumber  String
  supplierId           String
  orderDate            DateTime
  quotationDate        DateTime?
  validUntilDate       DateTime?
  expectedDeliveryDate DateTime?
  deliveryLocationId   String
  status               PurchaseOrderStatus     @default(Draft)
  currency             String                  @default("ZAR")
  subtotal             Float                   @default(0)
  taxAmount            Float                   @default(0)
  discountAmount       Float                   @default(0)
  deliveryFee          Float                   @default(0)
  totalAmount          Float                   @default(0)
  supplierReference    String?
  internalReference    String?
  paymentTerms         String?
  deliveryAddress      String?
  eventReference       String?
  notes                String?
  createdByUserId      String
  approvedByUserId     String?
  approvedAt           DateTime?
  sentAt               DateTime?
  cancelledAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  deliveryLocation     StorageLocation         @relation("PurchaseOrderDeliveryLocation", fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  createdBy            User                    @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy           User?                   @relation("PurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lineItems            PurchaseOrderLineItem[]
  goodsReceipts        GoodsReceipt[]

  @@unique([organizationId, purchaseOrderNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([expectedDeliveryDate])
  @@index([archivedAt])
}

model PurchaseOrderLineItem {
  id                   String             @id @default(uuid())
  purchaseOrderId      String
  supplierProductId    String
  inventoryItemId      String?
  productNameSnapshot  String
  productSkuSnapshot   String?
  productBrandSnapshot String?
  productCostSnapshot  Float
  productVatSnapshot   Float?
  quantityOrdered      Float
  quantityReceived     Float              @default(0)
  unitPrice            Float
  taxRate              Float              @default(0)
  discountRate         Float              @default(0)
  lineSubtotal         Float
  lineDiscount         Float
  lineTax              Float
  lineTotal            Float
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierProduct      SupplierProduct    @relation(fields: [supplierProductId], references: [id], onDelete: Restrict)
  inventoryItem        InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  goodsReceiptLines    GoodsReceiptLine[]

  @@unique([purchaseOrderId, supplierProductId])
  @@index([purchaseOrderId])
  @@index([supplierProductId])
  @@index([inventoryItemId])
}

model AiDraft {
  id                String                  @id @default(uuid())
  capability        AiDraftCapability
  organizationId    String
  status            AiDraftStatus           @default(ReviewPending)
  extractionAdapter String
  draftPayload      Json
  approvedPayload   Json?
  warnings          Json?
  committedTargetId String?
  committedAt       DateTime?
  createdByUserId   String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User                    @relation("AiDraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceDocuments   AiDraftSourceDocument[]
  extractedFields   AiDraftExtractedField[]

  @@index([organizationId])
  @@index([capability])
  @@index([status])
  @@index([createdByUserId])
}

model AiDraftSourceDocument {
  id            String           @id @default(uuid())
  draftId       String
  inputType     AiDraftInputType
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  contentText   String?
  contentBase64 String?
  createdAt     DateTime         @default(now())
  draft         AiDraft          @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model AiDraftExtractedField {
  id              String               @id @default(uuid())
  draftId         String
  fieldPath       String
  label           String
  suggestedValue  Json?
  finalValue      Json?
  confidenceScore Float?
  sourceReference String?
  decision        AiDraftFieldDecision @default(Suggested)
  isRequired      Boolean              @default(false)
  lowConfidence   Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  draft           AiDraft              @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, fieldPath])
  @@index([draftId])
  @@index([decision])
}

model GoodsReceipt {
  id                   String             @id @default(uuid())
  organizationId       String
  purchaseOrderId      String
  receiptNumber        String
  receivedDate         DateTime
  storageLocationId    String
  supplierDeliveryNote String?
  receivedByUserId     String
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  storageLocation      StorageLocation    @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  receivedBy           User               @relation("GoodsReceiptReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  lines                GoodsReceiptLine[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([storageLocationId])
  @@index([receivedDate])
}

model GoodsReceiptLine {
  id                      String                @id @default(uuid())
  goodsReceiptId          String
  purchaseOrderLineItemId String
  inventoryItemId         String
  quantityReceived        Float
  quantityAccepted        Float
  quantityDamaged         Float
  notes                   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  goodsReceipt            GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineItem   PurchaseOrderLineItem @relation(fields: [purchaseOrderLineItemId], references: [id], onDelete: Restrict)
  inventoryItem           InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineItemId])
  @@index([inventoryItemId])
}

model SupplierEvent {
  id         String   @id @default(uuid())
  supplierId String
  eventId    String
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([supplierId, eventId])
  @@index([supplierId])
  @@index([eventId])
}

model SupplierQuotation {
  id          String    @id @default(uuid())
  supplierId  String
  quotationId String
  createdAt   DateTime  @default(now())
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([supplierId, quotationId])
  @@index([supplierId])
  @@index([quotationId])
}

model SupplierTask {
  id         String   @id @default(uuid())
  supplierId String
  taskId     String
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([supplierId, taskId])
  @@index([supplierId])
  @@index([taskId])
}

model QuotationItem {
  id              String    @id @default(uuid())
  quotationId     String
  description     String
  quantity        Int
  unitPriceCents  Int
  discountPercent Int       @default(0)
  discountCents   Int       @default(0)
  lineTotalCents  Int
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([sortOrder])
}

model AuditLog {
  id             String        @id @default(uuid())
  action         String
  details        String?
  createdAt      DateTime      @default(now())
  userId         String?
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([organizationId])
}

model OutboxEvent {
  id             String        @id @default(uuid())
  eventType      String
  payload        String
  createdAt      DateTime      @default(now())
  processedAt    DateTime?
  userId         String?
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([createdAt])
  @@index([processedAt])
}
