model User {
  id                               String                     @id @default(uuid())
  email                            String                     @unique
  passwordHash                     String?
  name                             String?
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt
  memberships                      Membership[]
  assignedEvents                   Event[]                    @relation("EventAssignedUser")
  createdTasks                     Task[]                     @relation("TaskCreatedBy")
  assignedTasks                    Task[]                     @relation("TaskAssignedUser")
  meetingNotesCreated              MeetingNote[]
  meetingActionItemsAssigned       MeetingActionItem[]
  stockMovementsCreated            StockMovement[]
  purchaseOrdersCreated            PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved           PurchaseOrder[]            @relation("PurchaseOrderApprovedBy")
  goodsReceiptsReceived            GoodsReceipt[]             @relation("GoodsReceiptReceivedBy")
  eventResourceAllocationsCreated  EventResourceAllocation[]  @relation("EventResourceAllocationCreatedBy")
  eventResourceAllocationsUpdated  EventResourceAllocation[]  @relation("EventResourceAllocationUpdatedBy")
  eventResourceOutstandingsCreated EventResourceOutstanding[] @relation("EventResourceOutstandingCreatedBy")
  aiDrafts                         AiDraft[]                  @relation("AiDraftCreatedBy")
  auditLogs                        AuditLog[]
  outboxEvents                     OutboxEvent[]
  clientBriefVersionsCreated       ClientBriefVersion[]       @relation("ClientBriefVersionCreatedBy")
  eventDesignVersionsCreated       EventDesignVersion[]       @relation("EventDesignVersionCreatedBy")
  eventDesignVersionsApproved      EventDesignVersion[]       @relation("EventDesignVersionApprovedBy")
  requirementSetsCreated           RequirementSet[]           @relation("RequirementSetCreatedBy")
  requirementSetsApproved          RequirementSet[]           @relation("RequirementSetApprovedBy")
  requirementItemChanges           RequirementItemChange[]
  requirementImpactReportsCreated  RequirementImpactReport[]  @relation("RequirementImpactReportCreatedBy")
  requirementImpactReportsResolved RequirementImpactReport[]  @relation("RequirementImpactReportResolvedBy")
  moodBoardsCreated                MoodBoard[]                @relation("MoodBoardCreatedBy")
  moodBoardsApproved               MoodBoard[]                @relation("MoodBoardApprovedBy")
  moodBoardReviews                 MoodBoardReview[]
  procurementPackagesCreated       ProcurementPackage[]       @relation("ProcurementPackageCreatedBy")
  procurementSolutionsSelected     ProcurementSolution[]      @relation("ProcurementSolutionSelectedBy")
  commercialWorkspacesCreated      CommercialWorkspace[]      @relation("CommercialWorkspaceCreatedBy")
  commercialRfqsApproved           CommercialRfq[]            @relation("CommercialRfqApprovedBy")
  commercialMessagesAuthored       CommercialMessage[]
  assetDefinitionsCreated          AssetDefinition[]          @relation("AssetDefinitionCreatedBy")
  assetInstancesCreated            AssetInstance[]            @relation("AssetInstanceCreatedBy")
  eventExecutionsCreated           EventExecution[]           @relation("EventExecutionCreatedBy")
  financeWorkspacesCreated         EventFinanceWorkspace[]    @relation("EventFinanceWorkspaceCreatedBy")

  @@index([email])
}

model Organization {
  id                        String                     @id @default(uuid())
  name                      String
  slug                      String                     @unique
  tradingName               String?
  vatNumber                 String?
  registrationNumber        String?
  email                     String?
  phone                     String?
  website                   String?
  physicalAddress           String?
  postalAddress             String?
  logoUrl                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  memberships               Membership[]
  roles                     Role[]
  contacts                  Contact[]
  suppliers                 Supplier[]
  supplierProducts          SupplierProduct[]
  events                    Event[]
  meetingNotes              MeetingNote[]
  quotations                Quotation[]
  tasks                     Task[]
  inventoryItems            InventoryItem[]
  inventoryCategories       InventoryCategory[]
  storageLocations          StorageLocation[]
  stockMovements            StockMovement[]
  purchaseOrders            PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]
  aiDrafts                  AiDraft[]
  resources                 Resource[]
  resourceReservations      ResourceReservation[]
  eventResourceAllocations  EventResourceAllocation[]
  eventResourceOutstandings EventResourceOutstanding[]
  auditLogs                 AuditLog[]
  outboxEvents              OutboxEvent[]
  clientBriefVersions       ClientBriefVersion[]
  eventDesignVersions       EventDesignVersion[]
  requirementSets           RequirementSet[]
  requirementImpactReports  RequirementImpactReport[]
  moodBoards                MoodBoard[]
  procurementPackages       ProcurementPackage[]
  commercialWorkspaces      CommercialWorkspace[]
  assetDefinitions          AssetDefinition[]
  assetInstances            AssetInstance[]
  assetBatches              AssetBatch[]
  assetKits                 AssetKit[]
  eventExecutions           EventExecution[]
  financeWorkspaces         EventFinanceWorkspace[]

  @@index([slug])
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String
  permissions    String
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isSystem])
}

model Membership {
  id             String       @id @default(uuid())
  role           String
  isDisabled     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  mobile         String?
  companyName    String?
  contactType    String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         Event[]
  quotations     Quotation[]

  @@index([organizationId])
  @@index([email])
  @@index([archivedAt])
}

model Event {
  id                       String                     @id @default(uuid())
  organizationId           String
  contactId                String
  assignedUserId           String?
  title                    String
  eventType                String
  eventDate                DateTime
  startTime                String
  endTime                  String
  venue                    String?
  budgetCents              Int?
  notes                    String?
  description              String?
  startDateTime            DateTime
  endDateTime              DateTime
  location                 String?
  status                   EventStatus
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact                  Contact                    @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedUser             User?                      @relation("EventAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  quotations               Quotation[]
  tasks                    Task[]
  meetingNotes             MeetingNote[]
  supplierLinks            SupplierEvent[]
  resourceAllocations      EventResourceAllocation[]
  resourceOutstandings     EventResourceOutstanding[]
  clientBriefVersions      ClientBriefVersion[]
  eventDesignVersions      EventDesignVersion[]
  requirementSets          RequirementSet[]
  requirementImpactReports RequirementImpactReport[]
  moodBoards               MoodBoard[]
  procurementPackages      ProcurementPackage[]
  commercialWorkspaces     CommercialWorkspace[]
  eventExecution           EventExecution?
  financeWorkspace         EventFinanceWorkspace?

  @@index([organizationId])
  @@index([contactId])
  @@index([assignedUserId])
  @@index([eventDate])
  @@index([eventType])
  @@index([startDateTime])
  @@index([status])
  @@index([title])
}

model ClientBriefVersion {
  id                  String               @id @default(uuid())
  organizationId      String
  eventId             String
  version             Int
  clientName          String
  eventName           String
  eventDates          DateTime[]
  venue               String?
  expectedGuests      Int?
  budgetCents         Int?
  dressCode           String?
  eventType           String
  clientObjectives    String?
  initialRequirements String?
  notes               String?
  attachments         Json?
  createdByUserId     String
  createdAt           DateTime             @default(now())
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation("ClientBriefVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  eventDesignVersions EventDesignVersion[]

  @@unique([eventId, version])
  @@index([organizationId])
  @@index([createdByUserId])
}

model EventDesignVersion {
  id                   String             @id @default(uuid())
  organizationId       String
  eventId              String
  clientBriefVersionId String
  version              Int
  status               EventDesignStatus  @default(Draft)
  seating              Json?
  decor                Json?
  catering             Json?
  entertainment        Json?
  lightingAndAv        Json?
  branding             Json?
  infrastructure       Json?
  staffing             Json?
  createdByUserId      String
  approvedByUserId     String?
  approvedAt           DateTime?
  createdAt            DateTime           @default(now())
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clientBriefVersion   ClientBriefVersion @relation(fields: [clientBriefVersionId], references: [id], onDelete: Restrict)
  createdBy            User               @relation("EventDesignVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy           User?              @relation("EventDesignVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  requirementSets      RequirementSet[]
  moodBoards           MoodBoard[]

  @@unique([eventId, version])
  @@index([organizationId])
  @@index([clientBriefVersionId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([eventId, status])
}

model RequirementSet {
  id                   String                    @id @default(uuid())
  organizationId       String
  eventId              String
  eventDesignVersionId String
  version              Int
  status               RequirementSetStatus      @default(Draft)
  createdByUserId      String
  approvedByUserId     String?
  approvedAt           DateTime?
  createdAt            DateTime                  @default(now())
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDesignVersion   EventDesignVersion        @relation(fields: [eventDesignVersionId], references: [id], onDelete: Restrict)
  createdBy            User                      @relation("RequirementSetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy           User?                     @relation("RequirementSetApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  items                RequirementItem[]
  dependencies         RequirementDependency[]
  changes              RequirementItemChange[]
  impactReports        RequirementImpactReport[]
  moodBoards           MoodBoard[]
  procurementPackages  ProcurementPackage[]

  @@unique([eventId, version])
  @@index([organizationId])
  @@index([eventDesignVersionId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([eventId, status])
}

model RequirementItem {
  id                             String                          @id @default(uuid())
  requirementSetId               String
  requirementCode                String
  requirementVersion             Int
  category                       String
  requirementType                RequirementType
  name                           String
  description                    String?
  specification                  Json?
  images                         Json?
  quantityRequired               Float
  unit                           String
  quantitySource                 RequirementQuantitySource
  plannerOverride                Boolean                         @default(false)
  overrideReason                 String?
  deliveryDate                   DateTime?
  collectionDate                 DateTime?
  setupDate                      DateTime?
  removalDate                    DateTime?
  requiredTime                   String?
  venue                          String?
  deliveryArea                   String?
  setupArea                      String?
  gps                            String?
  status                         RequirementStatus               @default(Draft)
  fulfilmentStrategy             RequirementFulfilmentStrategy   @default(Undecided)
  supplierAllocation             Json?
  estimatedBudgetCents           Int?
  quotedPriceCents               Int?
  approvedPriceCents             Int?
  actualCostCents                Int?
  aiConfidence                   Float?
  aiRecommendation               String?
  alternativeSuggestions         Json?
  similarMarketplaceItems        Json?
  riskWarnings                   Json?
  createdAt                      DateTime                        @default(now())
  requirementSet                 RequirementSet                  @relation(fields: [requirementSetId], references: [id], onDelete: Cascade)
  dependenciesFrom               RequirementDependency[]         @relation("RequirementDependencySource")
  dependenciesTo                 RequirementDependency[]         @relation("RequirementDependencyTarget")
  changes                        RequirementItemChange[]
  moodBoardObjects               MoodBoardObject[]
  procurementPackageItems        ProcurementPackageItem[]
  procurementSolutionAllocations ProcurementSolutionAllocation[]
  commercialRfqLines             CommercialRfqLine[]

  @@unique([requirementSetId, requirementCode])
  @@index([requirementSetId, category])
  @@index([requirementSetId, status])
}

model RequirementDependency {
  id                      String                     @id @default(uuid())
  requirementSetId        String
  sourceRequirementItemId String
  targetRequirementItemId String
  level                   RequirementDependencyLevel
  description             String?
  createdAt               DateTime                   @default(now())
  requirementSet          RequirementSet             @relation(fields: [requirementSetId], references: [id], onDelete: Cascade)
  sourceRequirementItem   RequirementItem            @relation("RequirementDependencySource", fields: [sourceRequirementItemId], references: [id], onDelete: Cascade)
  targetRequirementItem   RequirementItem            @relation("RequirementDependencyTarget", fields: [targetRequirementItemId], references: [id], onDelete: Cascade)

  @@unique([requirementSetId, sourceRequirementItemId, targetRequirementItemId])
  @@index([sourceRequirementItemId])
  @@index([targetRequirementItemId])
}

model RequirementItemChange {
  id                String          @id @default(uuid())
  requirementSetId  String
  requirementItemId String
  changedByUserId   String
  changeType        String
  previousValue     Json?
  nextValue         Json?
  reason            String?
  createdAt         DateTime        @default(now())
  requirementSet    RequirementSet  @relation(fields: [requirementSetId], references: [id], onDelete: Cascade)
  requirementItem   RequirementItem @relation(fields: [requirementItemId], references: [id], onDelete: Cascade)
  changedBy         User            @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([requirementSetId])
  @@index([requirementItemId])
  @@index([changedByUserId])
}

model RequirementImpactReport {
  id                        String                        @id @default(uuid())
  organizationId            String
  eventId                   String
  baselineRequirementSetId  String
  status                    RequirementImpactReportStatus @default(PendingReview)
  affectedItems             Int
  newItems                  Int
  removedItems              Int
  plannerOverrides          Int
  requiresProcurementReview Boolean
  businessImpact            Json
  createdByUserId           String
  resolvedByUserId          String?
  resolvedAt                DateTime?
  createdAt                 DateTime                      @default(now())
  organization              Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                     Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  baselineRequirementSet    RequirementSet                @relation(fields: [baselineRequirementSetId], references: [id], onDelete: Restrict)
  createdBy                 User                          @relation("RequirementImpactReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
